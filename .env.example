# Local development — Vite proxies /api → http://127.0.0.1:8000 (see vite.config.js)
# Copy to .env.local for local dev:
VITE_API_URL=/api

# Production on Vercel uses /api (vercel.json proxies to Render). No env var needed.
# Remove VITE_API_URL from Vercel if you previously set a full onrender.com URL.
