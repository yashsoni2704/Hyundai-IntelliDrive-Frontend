# Local development — Vite proxies /api → http://127.0.0.1:8000 (see vite.config.js)
# Copy to .env.local for local dev:
VITE_API_URL=/api

# Vercel production — set in Vercel Dashboard → Settings → Environment Variables
# (do NOT commit real production values; Vite bakes this in at build time)
# VITE_API_URL=https://your-backend-service.onrender.com
